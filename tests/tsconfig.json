{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "es2022",
    "rootDir": "..",
    "outDir": "../.tests-out",
    "noEmit": true,
    "declaration": false,
    "types": ["jest", "node"],
    "baseUrl": "..",
    "paths": {
      "@webbar/node-multi-storage": ["packages/core/src"],
      "@webbar/node-multi-storage/testing": ["packages/core/src/testing"],
      "nestjs-multi-storage": ["packages/nestjs/src"]
    }
  },
  "include": ["./**/*.ts", "../packages/*/src/**/*.ts", "../scripts/**/*.ts"],
  "exclude": ["node_modules"]
}
