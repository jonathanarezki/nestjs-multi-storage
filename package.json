{
  "name": "nestjs-multi-storage",
  "version": "0.5.1",
  "description": "A multi-storage filesystem manager for NestJS, based on fs function names",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "nestjs-storage",
    "nestjs-filesystem",
    "nestjs-s3"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jonathanarezki/nestjs-multi-storage.git"
  },
  "bugs": {
    "url": "https://github.com/jonathanarezki/nestjs-multi-storage/issues"
  },
  "homepage": "https://github.com/jonathanarezki/nestjs-multi-storage",
  "author": "Jonathan Arezki <arezki@webbar.dev>",
  "private": false,
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "prettier --write \"**/*.ts\"",
    "lint": "eslint 'lib/**/*.ts' --fix",
    "prepublishOnly": "npm run build",
    "prepublish:npm": "npm run build",
    "publish:npm": "npm publish --access public",
    "prepublish:next": "npm run build",
    "publish:next": "npm publish --access public --tag next",
    "test:e2e": "jest --config ./tests/jest-e2e.json --runInBand",
    "test:e2e:dev": "jest --config ./tests/jest-e2e.json --runInBand --watch"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@aws-sdk/lib-storage": "^3.1160.0",
    "@aws-sdk/s3-request-presigner": "^3.1160.0",
    "@nestjs/common": "^11.0.0",
    "mime-types": "^3.0.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.8",
    "@types/jest": "^30.0.0",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-prettier": "^4.2.5",
    "jest": "^30.5.2",
    "memfs": "^4.80.0",
    "prettier": "^2.8.8",
    "reflect-metadata": "^0.1.14",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "memfs": "^4.80.0"
  },
  "peerDependenciesMeta": {
    "memfs": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
