{
  "name": "node-multi-storage-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @webbar/node-multi-storage && npm run build -w nestjs-multi-storage",
    "format": "prettier --write \"packages/*/src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "lint": "eslint \"packages/*/src/**/*.ts\" --fix",
    "test:e2e": "jest --config ./tests/jest-e2e.json",
    "test:e2e:fast": "E2E_BACKENDS=memory,fileSystem jest --config ./tests/jest-e2e.json",
    "test:e2e:dev": "jest --config ./tests/jest-e2e.json --runInBand --watch",
    "check:api": "node scripts/api-compat/check.js"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@aws-sdk/lib-storage": "^3.1160.0",
    "@aws-sdk/s3-request-presigner": "^3.1160.0",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/testing": "^11.2.8",
    "@types/jest": "^30.0.0",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.20.5",
    "@types/ssh2": "^1.15.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "basic-ftp": "^6.2.5",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-prettier": "^4.2.5",
    "jest": "^30.5.2",
    "memfs": "^4.80.0",
    "prettier": "^2.8.8",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.2",
    "ssh2": "^1.17.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
